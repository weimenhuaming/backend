syntax = "v1"

info (
	title: "Agent Server"
	desc:  "基于 LangChainGo 的 Agent 服务，个人知识库问答"
)

type (
	CreateSessionReq {
		SessionId string `json:"session_id,optional"`
		UserId    string `json:"user_id,optional"`
	}

	CreateSessionData {
		SessionId string `json:"session_id"`
		UserId    string `json:"user_id"`
		CreatedAt int64  `json:"created_at"`
		Message   string `json:"message"`
	}

	AgentChatReq {
		SessionId string `json:"session_id,optional"`
		UserId    string `json:"user_id,optional"`
		Question  string `json:"question"`
	}

	AgentChatData {
		SessionId string `json:"session_id"`
		Answer    string `json:"answer"`
		MessageId string `json:"message_id"`
		Timestamp int64  `json:"timestamp"`
	}

	AgentChatStreamChunk {
		Content   string `json:"content,optional"`
		Done      bool   `json:"done"`
		SessionId string `json:"session_id,optional"`
		MessageId string `json:"message_id,optional"`
	}

	KnowledgeCollectionInfo {
		Name       string `json:"name"`
		DocCount   int32  `json:"doc_count"`
		ChunkCount int32  `json:"chunk_count"`
		Count      int32  `json:"count"`
	}

	ListKnowledgeCollectionsReq {}
	ListKnowledgeCollectionsData {
		Collections []KnowledgeCollectionInfo `json:"collections"`
	}

	BuildKnowledgeReq {
		Collection string `json:"collection"`
	}
	BuildKnowledgeData {
		Message    string `json:"message"`
		DocCount   int32  `json:"doc_count"`
		ChunkCount int32  `json:"chunk_count"`
	}

	SwitchKnowledgeRetrieverReq {
		Collection string `json:"collection"`
	}
	SwitchKnowledgeRetrieverData {
		Message string `json:"message"`
	}

	DeleteKnowledgeCollectionReq {
		Collection string `json:"collection"`
	}
)

@server (
	group: agent
)
service Gateway {
	@handler CreateSession
	post /agent/session/create (CreateSessionReq) returns (CreateSessionData)

	@handler AgentChat
	post /agent/chat (AgentChatReq) returns (AgentChatData)
}

@server (
	group: agent
	sse:   true
)
service Gateway {
	@handler AgentChatStream
	post /agent/chat/stream (AgentChatReq) returns (AgentChatStreamChunk)
}

@server (
	middleware: AuthMiddleware
	group:      agent
)
service Gateway {
	@handler ListKnowledgeCollections
	get /agent/knowledge/collections (ListKnowledgeCollectionsReq) returns (ListKnowledgeCollectionsData)

	@handler BuildKnowledge
	post /agent/knowledge/build (BuildKnowledgeReq) returns (BuildKnowledgeData)

	@handler SwitchKnowledgeRetriever
	post /agent/knowledge/switch (SwitchKnowledgeRetrieverReq) returns (SwitchKnowledgeRetrieverData)

	@handler DeleteKnowledgeCollection
	delete /agent/knowledge/collection (DeleteKnowledgeCollectionReq)
}
