syntax = "v1"

info (
	title: "Agent Server"
	desc:  "基于 LangChainGo 的 Agent 服务，个人知识库问答"
)

type (
	CreateSessionReq {
		SessionId string `json:"session_id,optional"`
		UserId    string `json:"user_id,optional"`
	}

	CreateSessionData {
		SessionId string `json:"session_id"`
		UserId    string `json:"user_id"`
		CreatedAt int64  `json:"created_at"`
		Message   string `json:"message"`
	}

	CreateSessionResp {
		Code int               `json:"code"`
		Msg  string            `json:"msg"`
		Data CreateSessionData `json:"data"`
	}

	AgentChatReq {
		SessionId string `json:"session_id,optional"`
		UserId    string `json:"user_id,optional"`
		Question  string `json:"question"`
	}

	AgentChatData {
		SessionId string `json:"session_id"`
		Answer    string `json:"answer"`
		MessageId string `json:"message_id"`
		Timestamp int64  `json:"timestamp"`
	}

	AgentChatResp {
		Code int           `json:"code"`
		Msg  string        `json:"msg"`
		Data AgentChatData `json:"data"`
	}

	KnowledgeCollectionInfo {
		Name       string `json:"name"`
		DocCount   int32  `json:"doc_count"`
		ChunkCount int32  `json:"chunk_count"`
		Count      int32  `json:"count"`
	}

	ListKnowledgeCollectionsReq {}

	ListKnowledgeCollectionsData {
		Collections []KnowledgeCollectionInfo `json:"collections"`
	}

	ListKnowledgeCollectionsResp {
		Code int                        `json:"code"`
		Msg  string                     `json:"msg"`
		Data ListKnowledgeCollectionsData `json:"data"`
	}

	BuildKnowledgeReq {
		Collection string `json:"collection"`
	}

	BuildKnowledgeData {
		Message    string `json:"message"`
		DocCount   int32  `json:"doc_count"`
		ChunkCount int32  `json:"chunk_count"`
	}

	BuildKnowledgeResp {
		Code int              `json:"code"`
		Msg  string           `json:"msg"`
		Data BuildKnowledgeData `json:"data"`
	}

	SwitchKnowledgeRetrieverReq {
		Collection string `json:"collection"`
	}

	SwitchKnowledgeRetrieverData {
		Message string `json:"message"`
	}

	SwitchKnowledgeRetrieverResp {
		Code int                        `json:"code"`
		Msg  string                     `json:"msg"`
		Data SwitchKnowledgeRetrieverData `json:"data"`
	}

	DeleteKnowledgeCollectionReq {
		Collection string `json:"collection"`
	}

	DeleteKnowledgeCollectionResp {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
	}
)

@server (
	group: agent
)
service Gateway {
	@handler CreateSession
	post /agent/session/create (CreateSessionReq) returns (CreateSessionResp)

	@handler AgentChat
	post /agent/chat (AgentChatReq) returns (AgentChatResp)
}

@server (
	middleware: AuthMiddleware
	group:      agent
)
service Gateway {
	@handler ListKnowledgeCollections
	get /agent/knowledge/collections (ListKnowledgeCollectionsReq) returns (ListKnowledgeCollectionsResp)

	@handler BuildKnowledge
	post /agent/knowledge/build (BuildKnowledgeReq) returns (BuildKnowledgeResp)

	@handler SwitchKnowledgeRetriever
	post /agent/knowledge/switch (SwitchKnowledgeRetrieverReq) returns (SwitchKnowledgeRetrieverResp)

	@handler DeleteKnowledgeCollection
	delete /agent/knowledge/collection (DeleteKnowledgeCollectionReq) returns (DeleteKnowledgeCollectionResp)
}
