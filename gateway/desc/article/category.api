syntax = "v1"

info (
	title: "分类服务api"
	desc: "博客分类（如 前端/后端/Java/Go 等）相关接口"
)

type (
	// 分类信息
	CategoryInfo {
		Id   uint64 `json:"id"`
		Name string `json:"name"`
	}

	// 创建分类
	CreateCategoryReq {
		Name string `json:"name"`
	}
	CreateCategoryResp {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
	}

	// 列出分类
	ListCategoriesReq {
	}
	ListCategoriesResp {
		Code int               `json:"code"`
		Msg  string            `json:"msg"`
		Data ListCategoriesData `json:"data"`
	}
	ListCategoriesData {
		Categories []CategoryInfo `json:"categories"`
	}

	// 删除分类
	DeleteCategoryReq {
		Id uint64 `json:"id"`
	}
	DeleteCategoryResp {
		Code int    `json:"code"`
		Msg  string `json:"msg"`
	}
)

@server (
	middleware: AuthMiddleware // 认证中间件，所有请求都需要经过这个中间件进行认证
	group: category
)
service Gateway {
	@handler createCategory
	post /category/create (CreateCategoryReq) returns (CreateCategoryResp)

	@handler deleteCategory
	delete /category/delete (DeleteCategoryReq) returns (DeleteCategoryResp)
}

@server (
	group: category
)
service Gateway {
	@handler listCategories
	get /category/list (ListCategoriesReq) returns (ListCategoriesResp)
}