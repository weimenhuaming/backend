syntax = "v1"

info (
	title: "分类服务api"
	desc: "博客分类（如 前端/后端/Java/Go 等）相关接口"
)

type (
	CategoryInfo {
		Id   uint64 `json:"id"`
		Name string `json:"name"`
	}

	CreateCategoryReq {
		Name string `json:"name"`
	}

	ListCategoriesReq {}
	ListCategoriesData {
		Categories []CategoryInfo `json:"categories"`
	}

	DeleteCategoryReq {
		Id uint64 `json:"id"`
	}
)

@server (
	middleware: AuthMiddleware
	group:      category
)
service Gateway {
	@handler createCategory
	post /category/create (CreateCategoryReq)

	@handler deleteCategory
	delete /category/delete (DeleteCategoryReq)
}

@server (
	group: category
)
service Gateway {
	@handler listCategories
	get /category/list (ListCategoriesReq) returns (ListCategoriesData)
}
