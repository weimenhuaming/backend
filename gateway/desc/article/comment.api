syntax = "v1"

info (
	title: "评论服务api"
	desc: "评论服务api内容"
)

type (
	CommentInfo {
		Id          uint64        `json:"id"`
		ArticleId   uint64        `json:"article_id"`
		UserId      uint64        `json:"user_id"`
		ParentId    uint64        `json:"parent_id"`
		RootId      uint64        `json:"root_id"`
		ReplyToId   uint64        `json:"reply_to_id,optional"`
		ReplyToName string        `json:"reply_to_name,optional"`
		Content     string        `json:"content"`
		LikeCount   uint32        `json:"like_count"`
		ChildCount  uint32        `json:"child_count"`
		CreatedAt   string        `json:"created_at"`
		UserName    string        `json:"user_name"`
		UserAvatar  string        `json:"user_avatar"`
		Replies     []CommentInfo `json:"replies,optional"`
	}

	CreateCommentReq {
		ArticleId uint64 `json:"article_id"`
		UserId    uint64 `json:"user_id"`
		Content   string `json:"content"`
	}
	CreateCommentData {
		CommentId uint64 `json:"comment_id"`
	}

	CreateReplyReq {
		RootId      uint64 `json:"root_id"`
		ParentId    uint64 `json:"parent_id"`
		UserId      uint64 `json:"user_id"`
		ReplyToId   uint64 `json:"reply_to_id"`
		ReplyToName string `json:"reply_to_name"`
		Content     string `json:"content"`
	}
	CreateReplyData {
		ReplyId uint64 `json:"reply_id"`
	}

	DeleteCommentReq {
		Id uint64 `json:"id"`
	}

	GetArticleCommentsReq {
		ArticleId uint64 `json:"article_id"`
		Page      uint32 `json:"page"`
		PageSize  uint32 `json:"page_size"`
		OrderBy   string `json:"order_by,optional"`
	}
	GetArticleCommentsData {
		Comments []CommentInfo `json:"comments"`
		Total    uint32        `json:"total"`
		Page     uint32        `json:"page"`
		PageSize uint32        `json:"page_size"`
	}

	GetCommentRepliesReq {
		RootId   uint64 `json:"root_id"`
		Page     uint32 `json:"page"`
		PageSize uint32 `json:"page_size"`
	}
	GetCommentRepliesData {
		Replies  []CommentInfo `json:"replies"`
		Total    uint32        `json:"total"`
		Page     uint32        `json:"page"`
		PageSize uint32        `json:"page_size"`
	}

	GetUserCommentsReq {
		UserId   uint64 `json:"user_id"`
		Page     uint32 `json:"page"`
		PageSize uint32 `json:"page_size"`
	}
	GetUserCommentsData {
		Comments []CommentInfo `json:"comments"`
		Total    uint32        `json:"total"`
		Page     uint32        `json:"page"`
		PageSize uint32        `json:"page_size"`
	}
)

@server (
	group: comment
)
service Gateway {
	@handler getArticleComments
	post /comment/article_list (GetArticleCommentsReq) returns (GetArticleCommentsData)

	@handler getCommentReplies
	post /comment/art_replies_list (GetCommentRepliesReq) returns (GetCommentRepliesData)
}

@server (
	middleware: AuthMiddleware
	group:      comment
)
service Gateway {
	@handler createComment
	post /comment/create (CreateCommentReq) returns (CreateCommentData)

	@handler createReply
	post /comment/reply/create (CreateReplyReq) returns (CreateReplyData)

	@handler deleteComment
	delete /comment/delete (DeleteCommentReq)

	@handler getUserComments
	get /comment/user/list (GetUserCommentsReq) returns (GetUserCommentsData)
}
