syntax = "v1"

info (
    title: "互动服务api"
    desc:  "点赞、浏览等互动接口"
)

type (
    LikeArticleReq {
        ArticleId uint64 `json:"article_id"`
    }
    LikeArticleResp {
        Code int              `json:"code"`
        Msg  string           `json:"msg"`
        Data LikeArticleData  `json:"data"`
    }
    LikeArticleData {
        LikeCount uint32 `json:"like_count"`
    }

    UnlikeArticleReq {
        ArticleId uint64 `json:"article_id"`
    }
    UnlikeArticleResp {
        Code int              `json:"code"`
        Msg  string           `json:"msg"`
        Data LikeArticleData  `json:"data"`
    }

    LikeCommentReq {
        CommentId uint64 `json:"comment_id"`
    }
    LikeCommentResp {
        Code int              `json:"code"`
        Msg  string           `json:"msg"`
        Data LikeCommentData  `json:"data"`
    }
    LikeCommentData {
        LikeCount uint32 `json:"like_count"`
    }

    UnlikeCommentReq {
        CommentId uint64 `json:"comment_id"`
    }
    UnlikeCommentResp {
        Code int              `json:"code"`
        Msg  string           `json:"msg"`
        Data LikeCommentData  `json:"data"`
    }

    ViewArticleReq {
        ArticleId uint64 `json:"article_id"`
    }
    ViewArticleResp {
        Code int             `json:"code"`
        Msg  string          `json:"msg"`
        Data ViewArticleData `json:"data"`
    }
    ViewArticleData {
        ViewCount uint32 `json:"view_count"`
    }

    GetArticleLikeStatusReq {
        ArticleId uint64 `json:"article_id"`
    }
    GetArticleLikeStatusResp {
        Code int                      `json:"code"`
        Msg  string                   `json:"msg"`
        Data GetArticleLikeStatusData `json:"data"`
    }
    GetArticleLikeStatusData {
        Liked bool `json:"liked"`
    }

    BatchGetCommentLikeStatusReq {
        CommentIds []uint64 `json:"comment_ids"`
    }
    BatchGetCommentLikeStatusResp {
        Code int                           `json:"code"`
        Msg  string                        `json:"msg"`
        Data BatchGetCommentLikeStatusData `json:"data"`
    }
    CommentLikeStatusItem {
        CommentId uint64 `json:"comment_id"`
        Liked     bool   `json:"liked"`
    }
    BatchGetCommentLikeStatusData {
        Items []CommentLikeStatusItem `json:"items"`
    }
)

@server (
    group: interaction
)
service Gateway {
    @handler viewArticle
    post /article/view (ViewArticleReq) returns (ViewArticleResp)
}

@server (
    middleware: AuthMiddleware
    group: interaction
)
service Gateway {
    @handler likeArticle
    post /article/like (LikeArticleReq) returns (LikeArticleResp)

    @handler unlikeArticle
    post /article/unlike (UnlikeArticleReq) returns (UnlikeArticleResp)

    @handler likeComment
    post /comment/like (LikeCommentReq) returns (LikeCommentResp)

    @handler unlikeComment
    post /comment/unlike (UnlikeCommentReq) returns (UnlikeCommentResp)

    @handler getArticleLikeStatus
    post /article/like_status (GetArticleLikeStatusReq) returns (GetArticleLikeStatusResp)

    @handler batchGetCommentLikeStatus
    post /comment/like_status/batch (BatchGetCommentLikeStatusReq) returns (BatchGetCommentLikeStatusResp)
}
