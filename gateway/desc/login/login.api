syntax = "v1"

info (
	title: "登入服务api"
	desc:  "登入服务api内容"
)

// goctl api go -api desc/login/login.api -dir . -style gozero
type (
    // 普通验证码
    CaptchaResp {
        Code int `json:"code"`
        Msg  string `json:"msg"`
        Data CaptchaData `json:"data"`
    }
    CaptchaData {
        CaptchaId string `json:"captcha_id"`
        PicBase64 string `json:"pic_base64"`
    }

    // 发送验证码到邮箱
    EmailReq {
        Email string `json:"email"`
    }
    EmailResp {
        Code int `json:"code"`
        Msg  string `json:"msg"`
    }

    // 注册请求和响应
	RegisterReq {
	    Name    string `json:"name"`
		Email    string `json:"email"`
		Password string `json:"password"`
		Captcha  string `json:"captcha"`
	}
	RegisterResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
	}

    // 登入请求和响应
	LoginEmailReq {
		Email        string `json:"email"`
		Captcha      string `json:"captcha"`
	}
	LoginResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data LoginData `json:"data"`
	}
	LoginData {
		Id           uint64 `json:"id"`
		Name         string `json:"name"`
		Phone        string `json:"phone"`
		Email        string `json:"email"`
		Uuid         string `json:"uuid"`
		Avatar       string `json:"avatar"`
		Role         string `json:"role"`
		Sex          string `json:"sex"`
		Age          uint64  `json:"age"`
		AccessToken  string `json:"access_token"`
		RefreshToken string `json:"refresh_token"`
	}

    // 找回密码请求和响应
	ResetPasswordReq {
		Email    string `json:"email"`
		Captcha  string `json:"captcha"`
		NewPassword string `json:"newpassword"`
		ConfirmPassword  string `json:"confirmpassword"`
	}
	ResetPasswordResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
	}

    RefreshReq{}
)

//======================================================================================================================
// 定义user api 服务的描述
@server (
	group: login
)
service Gateway {
    @handler RefreshToken
    post /refresh (RefreshReq) returns (LoginResp)

    // 邮箱登入操作
	@handler emailLogin
	post /emaillogin (LoginEmailReq) returns (LoginResp)

    // 注册功能
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

    // 验证码生成
	@handler captcha
	get /captcha returns (CaptchaResp)

    // 发送验证码到邮箱
	@handler sendEmail
	post /sendemail (EmailReq) returns (EmailResp)

    // 通过邮箱修改密码
	@handler reset_password_by_email
	post /reset_password_by_email (ResetPasswordReq) returns (ResetPasswordResp)
}
