syntax = "v1"

info (
	title: "登入服务api"
	desc:  "登入服务api内容"
)

// 生成代码: make gateway-code
type (
	// 普通验证码
	CaptchaData {
		CaptchaId string `json:"captcha_id"`
		PicBase64 string `json:"pic_base64"`
	}

	// 发送验证码到邮箱
	EmailReq {
		Email string `json:"email"`
	}

	// 注册请求
	RegisterReq {
		Name     string `json:"name"`
		Email    string `json:"email"`
		Password string `json:"password"`
		Captcha  string `json:"captcha"`
	}

	// 登入请求和响应
	LoginEmailReq {
		Email   string `json:"email"`
		Captcha string `json:"captcha"`
	}
	LoginReq {
		Name      string `json:"name"`
		Password  string `json:"password"`
		Code      string `json:"code"`
		CaptchaId string `json:"captcha_id"`
	}
	LoginData {
		Id           uint64 `json:"id"`
		Name         string `json:"name"`
		Phone        string `json:"phone"`
		Email        string `json:"email"`
		Uuid         string `json:"uuid"`
		Avatar       string `json:"avatar"`
		Role         string `json:"role"`
		Sex          string `json:"sex"`
		Age          uint64 `json:"age"`
		AccessToken  string `json:"access_token"`
		RefreshToken string `json:"refresh_token"`
	}

	// 找回密码
	ResetPasswordReq {
		Email           string `json:"email"`
		Captcha         string `json:"captcha"`
		NewPassword     string `json:"newpassword"`
		ConfirmPassword string `json:"confirmpassword"`
	}

	LogoutReq {}
)

//======================================================================================================================
@server (
	group: login
)
service Gateway {
	@handler emailLogin
	post /emaillogin (LoginEmailReq) returns (LoginData)

	@handler login
	post /login (LoginReq) returns (LoginData)

	@handler register
	post /register (RegisterReq)

	@handler captcha
	get /captcha returns (CaptchaData)

	@handler sendEmail
	post /sendemail (EmailReq)

	@handler reset_password_by_email
	post /reset_password_by_email (ResetPasswordReq)
}

@server (
	middleware: AuthMiddleware
	group:      login
)
service Gateway {
	@handler logout
	get /logout (LogoutReq)
}
