syntax = "v1"

info (
	title: "登入服务api"
	desc:  "登入服务api内容"
)

// goctl api go -api desc/login.api -dir . -style gozero
type (
    RefreshReq{}

	LoginEmailReq {
		Email        string `json:"email"`
		Captcha      string `json:"captcha"`
	}
	LoginReq {
		Name     string `json:"name"`
		Password  string `json:"password"`
		Code      string `json:"code"`
		CaptchaId string `json:"captcha_id"`
	}
	LoginResp {
		Id           uint64 `json:"id"`
		Name         string `json:"name"`
		Phone        string `json:"phone"`
		Email        string `json:"email"`
		Uuid         string `json:"uuid"`
		Avatar       string `json:"avatar"`
		Role         string `json:"role"`
		Sex          string `json:"sex"`
		Age          uint64  `json:"age"`
	}
	RegisterReq {
	    Name    string `json:"name"`
		Email    string `json:"email"`
		Password string `json:"password"`
		Captcha  string `json:"captcha"`
	}
	RegisterResp {
		success bool `json:"success"`
	}
	ResetPasswordReq {
		Email    string `json:"email"`
		Captcha  string `json:"captcha"`
		Password string `json:"password"`
		confirm  string `json:"confirm"`
	}
	ResetPasswordResp {
		success bool `json:"success"`
	}
	CaptchaResp {
		captchaId string `json:"captcha_id"` // 验证码的唯一标识，用于提交验证时使用
		picBase64 string `json:"pic_base64"` // base64编码的图像内容，前端可直接用于 <img>
	}
	EmailReq {
		email string `json:"email"`
	}
	EmailResp {
		success bool `json:"success"`
	}
)

//======================================================================================================================
// 定义user api 服务的描述
@server (
	group: login
)
service Gateway {
	// 通过这个关键字来描述当前这个请求具体执行的方法是谁

    @handler RefreshToken
    post /refresh (RefreshReq) returns (LoginResp)

	// 普通登入
	@handler login
	post /login (LoginReq) returns (LoginResp)

    // 邮箱登入操作
	@handler emailLogin
	post /email (LoginEmailReq) returns (LoginResp)

    // 注册功能
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

    // 验证码生成
	@handler captcha
	get /captcha returns (CaptchaResp)

    // 发送验证码到邮箱
	@handler sendEmail
	post /sendemail (EmailReq) returns (EmailResp)

    // 通过邮箱修改密码
	@handler reset_password_by_email
	post /reset_password_by_email (ResetPasswordReq) returns (ResetPasswordResp)
}



