syntax = "v1"

info (
	title: "登入服务api"
	desc:  "登入服务api内容"
)

// goctl api go -api desc/login/login.api -dir . -style gozero
type (
    RefreshReq{}

	LoginEmailReq {
		Email        string `json:"email"`
		Captcha      string `json:"captcha"`
	}
	// 统一的响应结构：LoginResp
	LoginResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data LoginData `json:"data"`
	}
	// LoginData：原来的 LoginResp 字段移入这里
	LoginData {
		Id           uint64 `json:"id"`
		Name         string `json:"name"`
		Phone        string `json:"phone"`
		Email        string `json:"email"`
		Uuid         string `json:"uuid"`
		Avatar       string `json:"avatar"`
		Role         string `json:"role"`
		Sex          string `json:"sex"`
		Age          uint64  `json:"age"`
		AccessToken  string `json:"access_token"`
		RefreshToken string `json:"refresh_token"`
	}

	RegisterReq {
	    Name    string `json:"name"`
		Email    string `json:"email"`
		Password string `json:"password"`
		Captcha  string `json:"captcha"`
	}
	// 统一的响应结构：RegisterResp
	RegisterResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data RegisterData `json:"data"`
	}
	// RegisterData：如果注册成功不需要额外数据，可以为空结构体
	RegisterData {}

	ResetPasswordReq {
		Email    string `json:"email"`
		Captcha  string `json:"captcha"`
		Password string `json:"password"`
		Confirm  string `json:"confirm"`
	}
	// 统一的响应结构：ResetPasswordResp
	ResetPasswordResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data ResetPasswordData `json:"data"`
	}
	// ResetPasswordData：原来的 success 字段移入这里
	ResetPasswordData {
		Success bool `json:"success"`
	}

	// 统一的响应结构：CaptchaResp
	CaptchaResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data CaptchaData `json:"data"`
	}
	// CaptchaData：原来的字段移入这里
	CaptchaData {
		CaptchaId string `json:"captcha_id"` // 验证码的唯一标识，用于提交验证时使用
		PicBase64 string `json:"pic_base64"` // base64编码的图像内容，前端可直接用于 <img>
	}

	EmailReq {
		Email string `json:"email"`
	}
	// 统一的响应结构：EmailResp
	EmailResp {
		Code int `json:"code"`
		Msg  string `json:"msg"`
		Data EmailData `json:"data"`
	}
	// EmailData：原来的 success 字段移入这里
	EmailData {
		Success bool `json:"success"`
	}
)

//======================================================================================================================
// 定义user api 服务的描述
@server (
	group: login
)
service Gateway {
    @handler RefreshToken
    post /refresh (RefreshReq) returns (LoginResp)

    // 邮箱登入操作
	@handler emailLogin
	post /emaillogin (LoginEmailReq) returns (LoginResp)

    // 注册功能
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

    // 验证码生成
	@handler captcha
	get /captcha returns (CaptchaResp)

    // 发送验证码到邮箱
	@handler sendEmail
	post /sendemail (EmailReq) returns (EmailResp)

    // 通过邮箱修改密码
	@handler reset_password_by_email
	post /reset_password_by_email (ResetPasswordReq) returns (ResetPasswordResp)
}
