syntax = "v1"

info (
	title: "上传api"
	desc:  "头像与博客图片本地上传"
)

type (
	UploadImageData {
		Url string `json:"url"`
	}
)

@server (
	group:      upload
	middleware: AuthMiddleware
)
service Gateway {
	@handler UploadAvatar
	post /upload/avatar returns (UploadImageData)

	@handler UploadBlogImage
	post /upload/blog returns (UploadImageData)
}
